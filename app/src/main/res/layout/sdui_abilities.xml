<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/spacing_m">

    <LinearLayout
        android:id="@+id/abilitiesHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/spacing_s">

        <TextView
            android:id="@+id/abilitiesTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/text_m"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/abilitiesToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_sdui_chip"
            android:paddingHorizontal="@dimen/spacing_m"
            android:paddingVertical="@dimen/spacing_xs"
            android:text="@string/sdui_show"
            android:textColor="@color/on_surface_secondary"
            android:textSize="@dimen/text_s"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/abilitiesList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/spacing_xs"
        android:visibility="gone" />
</LinearLayout>
